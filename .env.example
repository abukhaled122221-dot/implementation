# Copy this file to .env in the project root. Never commit the real .env file.
# Gmail SMTP settings for the THIQA password-reset email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=your-project-email@gmail.com
SMTP_PASS=your-16-character-google-app-password
MAIL_FROM=THIQA Graduation Project <your-project-email@gmail.com>

# Local development URL. For deployment, replace with the public website URL.
PUBLIC_BASE_URL=http://localhost:3000
RESET_TOKEN_TTL_MINUTES=30
